{
  // Cloudflare Workers: build bằng "npm run build", deploy bằng "npx wrangler deploy".
  "name": "skills-vn",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "skillsvn", "database_id": "ecfd9441-65ec-42f5-b791-ca3c7e197924" }
  ],
  "observability": { "enabled": true },
  // Biến công khai. Biến bí mật (SEPAY_WEBHOOK_SECRET, TELEGRAM_BOT_TOKEN...) đặt trong
  // Cloudflare → skills-vn → Settings → Variables and Secrets, không ghi vào đây.
  "keep_vars": true
}
