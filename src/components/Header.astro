---
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const links = [
  { href: '/thu-vien', label: 'Thư viện' },
  { href: '/nganh', label: 'Ngành nghề' },
  { href: '/bots', label: 'Bots & Teams' },
  { href: '/sach', label: 'Sách prompting' },
  { href: '/huong-dan', label: 'Cách cài' },
  { href: '/dich-vu', label: 'Dịch vụ' },
];
const active = (href) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="skills.vn, về trang chủ">skills<span>.vn</span></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav class="nav" id="nav" aria-label="Chính">
      {links.map((l) => <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="nav-pro" href="/pro" aria-current={path === '/pro' ? 'page' : undefined}>Gói Pro</a>
    </nav>
  </div>
</header>
