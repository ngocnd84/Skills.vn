---
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const links = [
  { href: '/thu-vien', label: 'Thư viện' },
  { href: '/thu-vien/tu-dong-hoa', label: 'Workflow n8n' },
  { href: '/huong-dan', label: 'Cách cài' },
  { href: '/dich-vu', label: 'Dịch vụ' },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3.5" y="3.5" width="25" height="25" rx="4" transform="rotate(-6 16 16)" fill="#fff" stroke="#1d6b57" stroke-width="3"/><path d="M11.2 19.6c.9 1.1 2.4 1.8 4.2 1.8 2.3 0 3.7-1.1 3.7-2.7 0-1.7-1.3-2.3-3.5-2.8-1.9-.4-2.8-.8-2.8-1.7 0-.8.8-1.4 2.1-1.4 1.2 0 2.2.5 2.9 1.2" fill="none" stroke="#102a2e" stroke-width="2.2" stroke-linecap="round"/></svg>
      skills.vn
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav class="nav" id="nav" aria-label="Chính">
      {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
      <a class="nav-pro" href="/pro" aria-current={path === '/pro' ? 'page' : undefined}>Gói Pro</a>
    </nav>
  </div>
</header>
