---
import Stamp from './Stamp.astro';
import { KIND } from '../lib/library.js';
const { item } = Astro.props;
const first = item.installs[0];
const haystack = [item.name, item.summary, item.description, item.categoryName, item.publisher, item.repo, ...item.platformNames].join(' ').toLowerCase();
---
<li class="row" data-featured={item.featured ? "1" : "0"} data-search={haystack} data-cat={item.category} data-kind={item.kind} data-lang={item.lang}>
  <div>
    <a class="row-title" href={`/skill/${item.slug}`}>{item.name}</a>
    <p class="row-summary">{item.summary}</p>
    <div class="row-meta">
      <span>{KIND[item.kind]}</span>
      <span>{item.categoryName}</span>
      <span>{item.official ? `Chính thức: ${item.publisher}` : item.publisher}</span>
      {item.lang === 'vi' && <span class="tag-vi">Tiếng Việt</span>}
    </div>
  </div>
  <div class="row-platforms">{item.platformNames.join(', ')}</div>
  <div><Stamp status={item.safety.status} /></div>
  <div class="row-action">
    {first?.cmd
      ? <button class="btn btn-ghost" data-copy={first.cmd} aria-label={`Chép lệnh cài ${item.name}`}>Chép lệnh cài</button>
      : <a class="btn btn-ghost" href={`/skill/${item.slug}`}>Xem cách cài</a>}
  </div>
</li>
