---
import SkillCard from './SkillCard.astro';
import { skills, categories, fold } from '../lib/site.js';
const PAGE = 24;
---
<div id="library">
  <form class="search" role="search" action="/thu-vien" onsubmit="return false" style="margin-top:20px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <label class="sr-only" for="lib-q">Tìm skill hoặc prompt</label>
    <input id="lib-q" name="q" type="search" autocomplete="off" placeholder="Tìm: thuế, BĐS, hợp đồng, menu, Shopee, giáo án..." />
  </form>

  <div class="chips" role="group" aria-label="Lọc theo ngành">
    <button type="button" class="chip" data-cat="" aria-pressed="true">Tất cả</button>
    {categories.map((c) => <button type="button" class="chip" data-cat={c.slug} aria-pressed="false">{c.name}</button>)}
  </div>

  <div class="toolbar">
    <div class="chips" role="tablist" aria-label="Loại nội dung" style="margin:0">
      <button type="button" class="chip" role="tab" data-tab="skills" aria-pressed="true" aria-selected="true">Skills</button>
      <button type="button" class="chip" role="tab" data-tab="prompts" aria-pressed="false" aria-selected="false">Prompts</button>
      <button type="button" class="chip" data-favonly aria-pressed="false">♥ Đã lưu</button>
    </div>
    <p class="result-meta" id="lib-count" aria-live="polite" style="margin:0"></p>
  </div>

  <ul class="grid" id="lib-skills">
    {skills.map((s) => <SkillCard skill={s} heading="h2" />)}
  </ul>

  <ul class="grid" id="lib-prompts" hidden>
    {skills.map((s) => (
      <li class="card prompt-card" data-search={fold([s.name, s.category, s.subcategory, s.prompt, ...s.tags].join(' '))} data-cat={s.categorySlug} data-slug={s.slug}>
        <div class="card-head">
          <span class="emoji" aria-hidden="true">{s.emoji}</span>
          <div>
            <h2 style="font-size:1rem;margin:0"><a href={`/skill/${s.slug}#prompt`} style="color:var(--ink);text-decoration:none">Prompt: {s.name}</a></h2>
            <p class="card-sub">{s.category}</p>
          </div>
        </div>
        <pre>{s.prompt}</pre>
        <div class="card-actions">
          <button class="btn btn-ghost btn-sm" data-copy={s.prompt} data-copy-msg="Đã chép prompt">Chép prompt</button>
          <button class="fav" data-fav={s.slug} aria-pressed="false" aria-label={`Lưu ${s.name}`} style="margin-left:auto">♡</button>
        </div>
      </li>
    ))}
  </ul>

  <p class="empty" id="lib-empty" hidden>Chưa có skill khớp. Thử từ khoá khác, hoặc <a href="#gop-skill">gửi yêu cầu skill</a> cho chúng tôi.</p>
  <p style="text-align:center;margin-top:24px"><button class="btn btn-ghost" id="lib-more" type="button">Xem thêm</button></p>
</div>

<script define:vars={{ PAGE }}>
  const fold = (s) => s.toLowerCase().replace(/đ/g, 'd').normalize('NFD').replace(/[̀-ͯ]/g, '');
  const q = document.getElementById('lib-q');
  const lists = { skills: document.getElementById('lib-skills'), prompts: document.getElementById('lib-prompts') };
  const count = document.getElementById('lib-count');
  const empty = document.getElementById('lib-empty');
  const more = document.getElementById('lib-more');
  const catBtns = [...document.querySelectorAll('#library [data-cat]')].filter((b) => b.tagName === 'BUTTON');
  const tabBtns = [...document.querySelectorAll('#library [data-tab]')];
  const favBtn = document.querySelector('#library [data-favonly]');
  const params = new URLSearchParams(location.search);
  const state = { q: params.get('q') || '', cat: params.get('nganh') || '', tab: 'skills', fav: false, limit: PAGE };
  q.value = state.q;
  const readFav = () => { try { return JSON.parse(localStorage.getItem('skillsvn:fav') || '[]'); } catch { return []; } };

  function render() {
    const words = fold(state.q).split(/\s+/).filter(Boolean);
    const fav = readFav();
    Object.entries(lists).forEach(([k, ul]) => (ul.hidden = k !== state.tab));
    const items = [...lists[state.tab].children];
    let shown = 0, matched = 0;
    for (const li of items) {
      const ok = (!state.cat || li.dataset.cat === state.cat)
        && (!state.fav || fav.includes(li.dataset.slug))
        && words.every((w) => li.dataset.search.includes(w));
      if (ok) matched++;
      const visible = ok && shown < state.limit;
      if (visible) shown++;
      li.hidden = !visible;
    }
    count.textContent = `${matched} ${state.tab === 'skills' ? 'skill' : 'prompt'}`;
    empty.hidden = matched > 0;
    more.hidden = matched <= state.limit;
    catBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === state.cat)));
    tabBtns.forEach((b) => { const on = b.dataset.tab === state.tab; b.setAttribute('aria-pressed', String(on)); b.setAttribute('aria-selected', String(on)); });
    favBtn.setAttribute('aria-pressed', String(state.fav));
  }
  function syncUrl() {
    const p = new URLSearchParams();
    if (state.q) p.set('q', state.q);
    if (state.cat) p.set('nganh', state.cat);
    history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
  }
  q.addEventListener('input', () => { state.q = q.value; state.limit = PAGE; render(); syncUrl(); });
  catBtns.forEach((b) => b.addEventListener('click', () => { state.cat = b.dataset.cat; state.limit = PAGE; render(); syncUrl(); }));
  tabBtns.forEach((b) => b.addEventListener('click', () => { state.tab = b.dataset.tab; state.limit = PAGE; render(); }));
  favBtn.addEventListener('click', () => { state.fav = !state.fav; render(); });
  more.addEventListener('click', () => { state.limit += PAGE; render(); });
  document.addEventListener('fav-change', () => state.fav && render());
  render();
</script>
