---
import Base from '../../layouts/Base.astro';
import quiz from '../../data/quiz.json';
import { books, breadcrumb, SITE } from '../../lib/site.js';
const bookLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: 'Sách Prompting tiếng Việt',
  url: `${SITE}/sach`,
  inLanguage: 'vi',
  author: { '@type': 'Organization', name: 'skills.vn' },
  isAccessibleForFree: true,
  hasPart: books.map((b) => ({ '@type': 'Chapter', position: b.number, name: b.title, url: `${SITE}/sach/${b.slug}` })),
};
---
<Base
  title="Sách prompting tiếng Việt: 6 chương miễn phí"
  description="Học viết prompt cho AI bằng tiếng Việt: prompt cơ bản, Chain-of-Thought, Few-shot, từ prompt tới skill, agent, bot, vibe coding và computer use."
  jsonLd={[bookLd, breadcrumb([['Trang chủ', '/'], ['Sách prompting', '/sach']])]}
>
  <section class="wrap" style="padding-top:36px">
    <h1 style="font-size:clamp(1.9rem,4.5vw,3rem)">Sách prompting tiếng Việt</h1>
    <p class="lead">6 chương ngắn, đọc mỗi chương trong 5 phút. Đi từ prompt đầu tiên tới cách đóng gói thành skill, agent và bot.</p>
    <ol class="grid" style="list-style:none">
      {books.map((b) => (
        <li class="card">
          <p class="card-sub" style="margin:0">Chương {b.number}</p>
          <h2 style="font-size:1.1rem;margin:0"><a href={`/sach/${b.slug}`} style="color:var(--ink);text-decoration:none">{b.title}</a></h2>
          <p style="margin:0;color:var(--muted);font-size:0.93rem">{b.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section">
    <div class="quiz" id="quiz">
      <h2 style="margin-bottom:6px">Góc cho bé: tập viết prompt</h2>
      <p class="muted" style="margin:0">3 câu hỏi vui để các bạn nhỏ học cách nói chuyện với AI cho rõ ràng.</p>
      <div id="quiz-body">
        <p style="font-weight:700;margin:20px 0 0" id="quiz-q"></p>
        <div class="quiz-opts" id="quiz-opts"></div>
        <p id="quiz-why" class="muted" aria-live="polite"></p>
        <button class="btn btn-ink" id="quiz-next" hidden>Câu tiếp theo</button>
      </div>
      <noscript><p>Bật JavaScript để chơi quiz.</p></noscript>
    </div>
  </section>

  <script define:vars={{ quiz }}>
    let step = 0, score = 0;
    const qEl = document.getElementById('quiz-q');
    const opts = document.getElementById('quiz-opts');
    const why = document.getElementById('quiz-why');
    const next = document.getElementById('quiz-next');
    function show() {
      if (step >= quiz.length) {
        qEl.textContent = `Bạn đúng ${score}/${quiz.length} câu. ${score === quiz.length ? 'Giỏi lắm!' : 'Chơi lại để đạt điểm tối đa nhé.'}`;
        opts.innerHTML = '';
        why.textContent = '';
        next.textContent = 'Chơi lại';
        next.hidden = false;
        step = -1;
        return;
      }
      const item = quiz[step];
      qEl.textContent = `Câu ${step + 1}/${quiz.length}: ${item.q}`;
      why.textContent = '';
      next.hidden = true;
      opts.innerHTML = '';
      item.opts.forEach((o, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = o;
        b.addEventListener('click', () => {
          [...opts.children].forEach((x, j) => { x.disabled = true; if (j === item.answer) x.classList.add('right'); });
          if (i === item.answer) score++; else b.classList.add('wrong');
          why.textContent = (i === item.answer ? 'Đúng rồi! ' : 'Chưa đúng. ') + item.why;
          next.textContent = step === quiz.length - 1 ? 'Xem kết quả' : 'Câu tiếp theo';
          next.hidden = false;
        });
        opts.appendChild(b);
      });
    }
    next.addEventListener('click', () => { if (step === -1) { step = 0; score = 0; } else step++; show(); });
    show();
  </script>
</Base>
