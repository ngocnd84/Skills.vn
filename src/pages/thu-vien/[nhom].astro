---
import Base from '../../layouts/Base.astro';
import Library from '../../components/Library.astro';
import { categories, inCategory, breadcrumb, itemListLd } from '../../lib/library.js';
export function getStaticPaths() {
  return categories.map((c) => ({ params: { nhom: c.id }, props: { cat: c } }));
}
const { cat } = Astro.props;
const list = inCategory(cat.id);
---
<Base title={cat.title} description={cat.intro.slice(0, 158)} jsonLd={[breadcrumb([['Trang chủ', '/'], ['Thư viện', '/thu-vien'], [cat.name, `/thu-vien/${cat.id}`]]), itemListLd(list, cat.h1)]}>
  <section class="hero wrap" style="padding-top:28px">
    <p class="crumbs" style="margin-top:0"><a href="/thu-vien">Thư viện</a> / {cat.name}</p>
    <h1 style="font-size:clamp(1.9rem,4vw,2.8rem)">{cat.h1}</h1>
    <p class="lead">{cat.intro}</p>
    <Library only={cat.id} />
  </section>
  <section class="wrap" style="padding:24px 20px 64px">
    <p class="muted measure">Chưa thấy skill bạn cần? <a href="/dich-vu">Chúng tôi viết skill riêng</a> theo quy trình của công ty bạn.</p>
  </section>
</Base>
