---
import Base from '../../layouts/Base.astro';
import SkillCard from '../../components/SkillCard.astro';
import { skills, categoryBySlug, skillBySlug, skillsIn, breadcrumb, faqLd, fitTitle, SITE, PUBLISHED } from '../../lib/site.js';

export function getStaticPaths() {
  return skills.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const cat = categoryBySlug[s.categorySlug];
const related = s.related.map((r) => skillBySlug[r]).filter(Boolean);
const sameCat = skillsIn(s.categorySlug).filter((x) => x.slug !== s.slug);
const faq = [
  [`Skill ${s.name} dùng để làm gì?`, s.description],
  [`Cài skill ${s.name} vào Claude thế nào?`, `Tải file SKILL.md, đặt vào thư mục ${s.slug} rồi nén thành file .zip. Trong app Claude chọn Customize → Skills → Upload a skill. Với Claude Code, đặt file vào ~/.claude/skills/${s.slug}/SKILL.md.`],
  [`Dùng ${s.name} với ChatGPT hoặc Gemini được không?`, 'Được. Chép prompt mẫu trên trang này, dán vào khung chat rồi bổ sung dữ kiện của bạn.'],
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: s.name,
  headline: `${s.name} — Claude Skill tiếng Việt`,
  description: s.description,
  url: `${SITE}/skill/${s.slug}`,
  inLanguage: 'vi',
  genre: s.category,
  keywords: s.tags.join(', '),
  isAccessibleForFree: true,
  datePublished: PUBLISHED,
  author: { '@type': 'Organization', name: 'skills.vn', url: SITE },
  publisher: { '@type': 'Organization', name: 'skills.vn', url: SITE },
};
const title = fitTitle(`${s.name}: Claude Skill & prompt tiếng Việt`, `${s.name}: Claude Skill tiếng Việt`, `${s.name} — Claude Skill`, `${s.name}: skill AI`, s.name);
---
<Base
  title={title}
  description={`${s.description} Tải SKILL.md cho Claude hoặc chép prompt mẫu cho ChatGPT, Gemini. Miễn phí.`.slice(0, 160)}
  ogType="article"
  jsonLd={[ld, breadcrumb([['Trang chủ', '/'], [cat.name, `/nganh/${cat.slug}`], [s.name, `/skill/${s.slug}`]]), faqLd(faq)]}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a> / <a href={`/nganh/${cat.slug}`}>{cat.name}</a> / {s.subcategory}</nav>
    <div class="card-head" style="align-items:center;margin-bottom:8px">
      <span class="emoji" aria-hidden="true" style="width:56px;height:56px;font-size:1.8rem">{s.emoji}</span>
      <h1 style="font-size:clamp(1.8rem,4.2vw,2.8rem);margin:0">{s.name}</h1>
    </div>
    <p class="lead" style="margin-top:12px">{s.description}</p>
    <ul class="tags" style="margin-bottom:28px">{s.tags.map((t) => <li><a href={`/thu-vien?q=${encodeURIComponent(t)}`} style="color:inherit;text-decoration:none">{t}</a></li>)}</ul>

    <div class="detail">
      <div>
        {cat.note && <p class="notice">{cat.note}</p>}
        <section>
          <h2>Tổng quan</h2>
          <p>{s.longDescription}</p>
          <h3>Khi nào dùng</h3>
          <ul>{s.whenToUse.map((w) => <li>{w}</li>)}</ul>
          <div class="io">
            <div><b>Bạn cung cấp</b>{s.inputs}</div>
            <div><b>Bạn nhận được</b>{s.outputs}</div>
          </div>
        </section>

        <section id="skill-md">
          <div class="section-head" style="margin-bottom:12px">
            <h2>File SKILL.md</h2>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <button class="btn btn-ghost btn-sm" data-copy-from="md-src" data-copy-msg="Đã chép SKILL.md">Chép</button>
              <button class="btn btn-primary btn-sm" data-download="SKILL.md" data-copy-from="md-src">Tải SKILL.md</button>
            </div>
          </div>
          <div class="code"><pre id="md-src">{s.skillMd}</pre></div>
        </section>

        <section id="prompt">
          <div class="section-head" style="margin-bottom:12px">
            <h2>Prompt mẫu</h2>
            <button class="btn btn-ghost btn-sm" data-copy-from="prompt-src" data-copy-msg="Đã chép prompt">Chép prompt</button>
          </div>
          <p class="muted">Dùng được với ChatGPT, Gemini, Copilot hoặc Claude khi chưa cài skill.</p>
          <div class="code"><pre id="prompt-src">{s.prompt}</pre></div>
          <h3 style="margin-top:20px">Câu lệnh gọi skill</h3>
          <div class="cmd"><pre>{s.examplePrompt}</pre><button class="copy" data-copy={s.examplePrompt}>Chép</button></div>
        </section>

        <section>
          <h2>Ví dụ cách dùng</h2>
          {s.examples.map((e) => (<><p class="cmd-label">{e.title}</p><div class="cmd"><pre>{e.prompt}</pre><button class="copy" data-copy={e.prompt}>Chép</button></div></>))}
        </section>

        <section>
          <h2>Cách cài skill</h2>
          <ol>
            <li><b>App Claude (web, máy tính):</b> tải SKILL.md, đặt vào thư mục <code>{s.slug}</code>, nén thành .zip, rồi chọn Customize → Skills → Upload a skill.</li>
            <li><b>Claude Code:</b> lưu file vào <code>~/.claude/skills/{s.slug}/SKILL.md</code>. Claude Code tự nhận skill ở lần chạy sau.</li>
            <li><b>ChatGPT, Gemini, Copilot:</b> chép prompt mẫu ở trên và dán vào khung chat.</li>
          </ol>
          <p><a href="/huong-dan">Hướng dẫn cài skill chi tiết</a></p>
        </section>

        <section>
          <h2>Câu hỏi thường gặp</h2>
          {faq.map(([q, a]) => (<><h3>{q}</h3><p class="muted">{a}</p></>))}
        </section>
      </div>
      <aside>
        <dl class="facts">
          <dt>Ngành</dt><dd><a href={`/nganh/${cat.slug}`}>{cat.name}</a></dd>
          <dt>Nhóm</dt><dd>{s.subcategory}</dd>
          <dt>Dùng với</dt><dd>Claude, Claude Code (SKILL.md); ChatGPT, Gemini (prompt)</dd>
          <dt>Giá</dt><dd>Miễn phí</dd>
          <dt>Tác giả</dt><dd>skills.vn</dd>
        </dl>
        <div style="display:grid;gap:8px;margin-top:18px">
          <button class="btn btn-primary" data-download="SKILL.md" data-copy-from="md-src">Tải SKILL.md</button>
          <button class="btn btn-ghost" data-copy-from="prompt-src" data-copy-msg="Đã chép prompt">Chép prompt mẫu</button>
          <button class="btn btn-ghost" data-fav={s.slug} aria-pressed="false" aria-label="Lưu vào yêu thích">♡</button>
        </div>
      </aside>
    </div>
  </div>

  <section class="section section-alt">
    <div class="wrap">
      <h2>Skill liên quan</h2>
      <ul class="grid">{related.map((r) => <SkillCard skill={r} />)}</ul>
      <h2 style="margin-top:40px">Cùng ngành {cat.name}</h2>
      <ul class="grid">{sameCat.map((r) => <SkillCard skill={r} />)}</ul>
    </div>
  </section>
</Base>
