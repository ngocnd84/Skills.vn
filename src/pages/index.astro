---
import Base from '../layouts/Base.astro';
import SkillCard from '../components/SkillCard.astro';
import GopSkill from '../components/GopSkill.astro';
import site from '../data/site.json';
import { categories, featured, bots, teams, books, counts, skillsIn, itemListLd, faqLd, SITE } from '../lib/site.js';

const suggestions = ['hợp đồng', 'PRD', 'SEO', 'menu', 'tour', 'thuế', 'BĐS', 'xe', 'giáo án', 'Shopee'];
const faq = [
  ['Claude Skill là gì?', 'Claude Skill là một thư mục có file SKILL.md chứa hướng dẫn cho AI: dùng khi nào, làm theo các bước nào, kiểm tra ra sao. Cài một lần, Claude tự dùng khi việc bạn nhờ khớp với mô tả của skill.'],
  ['Skill trên skills.vn có mất phí không?', `Toàn bộ ${counts.skills} skill và prompt mẫu trong thư viện đều miễn phí. Gói Pro là các bộ skill chuyên sâu viết riêng cho doanh nghiệp Việt, bán riêng.`],
  ['Dùng skill với ChatGPT hay Gemini được không?', 'Được. File SKILL.md cài trực tiếp cho Claude và Claude Code. Với ChatGPT, Gemini hay Copilot, bạn chép phần prompt mẫu trên mỗi trang skill và dán vào khung chat.'],
  ['Tôi có thể góp skill của mình không?', 'Có. Gửi skill qua form góp skill ở cuối trang. Chúng tôi đọc, thử và đăng lên thư viện kèm tên bạn nếu bạn đồng ý.'],
];
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'skills.vn',
  url: SITE,
  logo: `${SITE}/favicon.svg`,
  ...(site.company ? { legalName: site.company } : {}),
  ...(site.email ? { email: site.email } : {}),
};
const webLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'skills.vn',
  url: SITE,
  inLanguage: 'vi',
  potentialAction: { '@type': 'SearchAction', target: `${SITE}/thu-vien?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---
<Base
  description={`${counts.skills} Claude Skill và prompt tiếng Việt cho ${counts.categories} ngành: viết content, hợp đồng, thuế, bất động sản, Shopee, giáo án. Tải SKILL.md hoặc chép prompt miễn phí.`}
  jsonLd={[orgLd, webLd, itemListLd(featured, 'Skill nổi bật'), faqLd(faq)]}
>
  <section class="hero-grid">
    <div class="wrap hero">
      <p class="badge" style="display:inline-block">Claude Skill · Prompt · Bot · 24 ngành nghề</p>
      <h1>Thư viện Claude Skill & prompt tiếng Việt cho mọi ngành nghề</h1>
      <p class="lead">{counts.skills} skill và {counts.prompts} prompt mẫu viết sẵn cho công việc thật ở Việt Nam: soạn hợp đồng, kê khai thuế, đăng tin BĐS, tối ưu Shopee, lên giáo án. Tải SKILL.md cho Claude hoặc chép prompt cho ChatGPT, Gemini.</p>
      <form class="search" role="search" action="/thu-vien" method="get">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <label class="sr-only" for="home-q">Tìm skill</label>
        <input id="home-q" name="q" type="search" placeholder="Tìm skill: thuế, BĐS, xe, tour, menu, hợp đồng..." />
        <button class="btn btn-primary" type="submit">Tìm skill</button>
      </form>
      <p class="suggest">Tìm nhiều: {suggestions.map((s) => <a href={`/thu-vien?q=${encodeURIComponent(s)}`}>{s}</a>)}</p>
      <div class="stats">
        <div><b>{counts.skills}</b><span>Skill</span></div>
        <div><b>{counts.prompts}</b><span>Prompt mẫu</span></div>
        <div><b>{counts.categories}</b><span>Ngành nghề</span></div>
        <div><b>{counts.bots} + {counts.teams}</b><span>Mẫu bot & team</span></div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div><p class="eyebrow">Skill nổi bật</p><h2>Chọn skill, chép là chạy</h2></div>
      <a class="btn btn-ghost" href="/thu-vien">Xem cả {counts.skills} skill</a>
    </div>
    <ul class="grid">{featured.map((s) => <SkillCard skill={s} />)}</ul>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Theo ngành nghề</p><h2>Skill cho đúng công việc của bạn</h2></div>
        <a class="btn btn-ghost" href="/nganh">Tất cả ngành</a>
      </div>
      <ul class="grid grid-4">
        {categories.map((c) => {
          const list = skillsIn(c.slug);
          return (
            <li><a class="tile" href={`/nganh/${c.slug}`}>
              <span class="emoji" aria-hidden="true">{c.emoji}</span>
              <span><b>{c.name}</b><small>{list.length} skill</small></span>
            </a></li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div><p class="eyebrow">Bots & Teams</p><h2>Ghép nhiều skill thành một bot làm việc</h2></div>
      <a class="btn btn-ghost" href="/bots">Xem {counts.bots} mẫu bot</a>
    </div>
    <p class="muted measure">Mỗi mẫu bot là một bộ skill đi cùng nhau cho một việc trọn vẹn. Ghép vài bot thành một team để chạy cả quy trình, từ ý tưởng tới bàn giao.</p>
    <ul class="grid">
      {teams.slice(0, 3).map((t) => (
        <li class="card">
          <div class="card-head"><span class="emoji" aria-hidden="true">{t.emoji}</span><div><h3><a href={`/bots#${t.slug}`}>{t.name}</a></h3><p class="card-sub">{t.category}</p></div></div>
          <p style="margin:0;color:var(--muted);font-size:0.93rem">{t.desc}</p>
          <ul class="flow">{t.members.map((m) => <li>{bots.find((b) => b.slug === m)?.name.replace(/^Bot /, '')}</li>)}</ul>
        </li>
      ))}
    </ul>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Sách prompting</p><h2>Học viết prompt trong {counts.chapters} chương ngắn</h2></div>
        <a class="btn btn-ghost" href="/sach">Đọc sách</a>
      </div>
      <ol class="grid" style="list-style:none">
        {books.map((b) => (
          <li class="card">
            <p class="card-sub" style="margin:0">Chương {b.number}</p>
            <h3><a href={`/sach/${b.slug}`}>{b.title}</a></h3>
            <p style="margin:0;color:var(--muted);font-size:0.93rem">{b.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap section">
    <div class="band">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:28px;align-items:center">
        <div>
          <h2>Cần bộ skill viết riêng cho doanh nghiệp?</h2>
          <p class="muted" style="margin:0">Gói Pro gồm các bộ skill chuyên sâu theo nghiệp vụ Việt Nam. Hoặc để chúng tôi cài skill và workflow cho cả đội của bạn.</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-primary" href="/pro">Xem Gói Pro</a>
          <a class="btn btn-ghost" href="/dich-vu">Dịch vụ cài đặt</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top:8px">
    <div class="detail detail-form" style="padding-bottom:0">
      <div class="measure">
        <h2>Câu hỏi thường gặp</h2>
        {faq.map(([q, a]) => (<><h3 style="margin-top:20px">{q}</h3><p class="muted">{a}</p></>))}
        <p><a href="/huong-dan">Xem hướng dẫn cài skill chi tiết</a></p>
      </div>
      <div id="gop-skill"><GopSkill /></div>
    </div>
  </section>
</Base>
